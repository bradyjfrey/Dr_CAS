<!DOCTYPE html>
<html lang="en">
<head>
    <meta name="Description" content="{{ description }}">
    <meta name="Author" content="Brady J. Frey">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta property="og:image" name="image" content="https://www.drcarlosalbertosanchez.com/images/drcasogimage.jpg">
{%- if ogTitle %}
    <meta property="og:title" content="{{ ogTitle }}">
    <meta property="og:description" content="{{ ogDescription or description }}">
{%- endif %}
    <title>{{ title }}</title>
    <link rel="icon" type="image/png" sizes="16x16" href="/images/favicon16.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon32.png">
    <link rel="icon" type="image/png" sizes="96x96" href="/images/favicon96.png">
    <link rel="apple-touch-icon" type="image/png" sizes="76x76" href="/images/touch76.png">
    <link rel="apple-touch-icon" type="image/png" sizes="120x120" href="/images/touch120.png">
    <link rel="apple-touch-icon" type="image/png" sizes="152x152" href="/images/touch152.png">
    <link rel="apple-touch-icon" type="image/png" sizes="167x167" href="/images/touch167.png">
    <link rel="apple-touch-icon" type="image/png" sizes="180x180" href="/images/touch180.png">
    <link rel="stylesheet" type="text/css" media="screen" href="style.css">
    <link rel="stylesheet" type="text/css" href="https://cloud.typography.com/7216232/7121832/css/fonts.css">
</head>
<body{% if bodyId %} id="{{ bodyId }}"{% endif %}{% if bodyClass %} class="{{ bodyClass }}"{% endif %}>
    <header>
        <nav class="top-nav">
            <div class="homel"><a{% if current == "home" %} id="current"{% endif %} href="index.html">Home</a></div>
            <input id="menu-toggle" type="checkbox">
            <label class="menu-button-container" for="menu-toggle">
                <div class="menu-button"></div>
            </label>
            <ul class="menu">
                <li><a{% if current == "books" %} id="current"{% endif %} href="books.html">Books</a></li>
                <li><a{% if current == "academic" %} id="current"{% endif %} href="academicwriting.html">Academic Writing</a></li>
                <li><a{% if current == "public" %} id="current"{% endif %} href="publicphilosophy.html">Public Philosophy</a></li>
                <li><a{% if current == "cv" %} id="current"{% endif %} href="cv.html">CV</a></li>
            </ul>
        </nav>
    </header>

    <main>
{{ content | safe }}
    </main>

    <footer>
        <p>Copyright &copy; Dr. Carlos Alberto Sánchez. All rights reserved.</p>
    </footer>
</body>
</html>
